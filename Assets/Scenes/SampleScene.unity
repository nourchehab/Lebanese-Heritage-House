  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 361358280d8342a4db1313fd1c6bf088, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::HousekeeperGuide
  radius: 2.3
  focusPoint: {fileID: 678163080}
  speakerName: Gatekeeper
  facePlayer: 1
  showNameLabel: 1
  labelHeight: 2.05
  lines:
  - speaker: 
    text: 'Welcome! Come in, quickly. Listen: you only have one hour to find the
      key and leave. And no one should know about this.'
  - speaker: You
    text: Okay, don't worry. But please, I need some information so I know what I'm
      supposed to look for.
  - speaker: 
    text: All I can tell you is that the owner of this house was Assem Salam. That's
      all I know. Be quick.
  exitPoint: {fileID: 1256974560}
  walkSpeed: 1.3
